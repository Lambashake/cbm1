<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chota Baby Mroq Destroys Chembur</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }
    body {
      background-color: #05050a;
      color: #00ff66;
      font-family: monospace, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
    }
    h1 {
      margin-bottom: 8px;
      font-size: 20px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #00ff66;
      text-shadow: 2px 2px #ff0055;
    }
    .game-box {
      position: relative;
      border: 4px solid #222;
      box-shadow: 0 0 20px rgba(0, 255, 102, 0.3);
    }
    canvas {
      display: block;
      background-color: #0a0014;
      image-rendering: pixelated;
    }
    .instructions {
      margin-top: 10px;
      color: #aaa;
      font-size: 13px;
    }
    kbd {
      background: #222;
      color: #fff;
      padding: 2px 6px;
      border-radius: 3px;
      border: 1px solid #444;
    }
  </style>
</head>
<body>

  <h1>CHOTA BABY MROQ DESTROYS CHEMBUR</h1>
  <div class="game-box">
    <canvas id="gameCanvas" width="800" height="450"></canvas>
  </div>
  <div class="instructions">
    Move: <kbd>A</kbd> / <kbd>D</kbd> or <kbd>←</kbd> / <kbd>→</kbd> | Smash: <kbd>SPACE</kbd> | Atomic Breath: <kbd>ENTER</kbd>
  </div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// --- PURE AUDIO SYNTHESIZER (No sound files needed) ---
let audioCtx = null;
function playSound(type) {
  if (!audioCtx) {
    try {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    } catch(e) { return; }
  }
  if (audioCtx.state === 'suspended') {
    audioCtx.resume();
  }

  try {
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    const now = audioCtx.currentTime;

    if (type === 'smash') {
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(140, now);
      osc.frequency.exponentialRampToValueAtTime(30, now + 0.15);
      gain.gain.setValueAtTime(0.3, now);
      gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
      osc.start(now); osc.stop(now + 0.15);
    } else if (type === 'breath') {
      osc.type = 'square';
      osc.frequency.setValueAtTime(250, now);
      osc.frequency.linearRampToValueAtTime(500, now + 0.1);
      osc.frequency.linearRampToValueAtTime(100, now + 0.3);
      gain.gain.setValueAtTime(0.2, now);
      gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
      osc.start(now); osc.stop(now + 0.3);
    } else if (type === 'rebuild') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(200, now);
      osc.frequency.exponentialRampToValueAtTime(700, now + 0.4);
      gain.gain.setValueAtTime(0.2, now);
      gain.gain.linearRampToValueAtTime(0.01, now + 0.4);
      osc.start(now); osc.stop(now + 0.4);
    }
  } catch(e) {}
}

// --- GAME VARIABLES ---
let gameState = 'START'; // 'START', 'PLAYING', 'GAMEOVER'
let score = 0;
let highScore = 0;
let timer = 60;
let dayCounter = 1;
let timerInterval = null;

const player = {
  x: 50,
  y: 270,
  w: 60,
  h: 90,
  speed: 5,
  dir: 'right',
  attacking: false,
  attackType: '',
  attackTimer: 0
};

let buildings = [];
let particles = [];
let popups = [];

const chemburPlaces = [
  "Chembur Stn", "KSTAR Mall", "Monorail", 
  "RK Studio", "Diamond Gdn", "Golf Club", "Fine Arts"
];

function initBuildings() {
  buildings = [];
  const count = 7;
  const spacing = 100;
  for (let i = 0; i < count; i++) {
    const h = 100 + Math.floor(Math.random() * 120);
    buildings.push({
      x: 80 + i * spacing,
      y: 360 - h,
      w: 80,
      h: h,
      hp: 100,
      maxHp: 100,
      name: chemburPlaces[i % chemburPlaces.length]
    });
  }
}

// --- INPUT HANDLERS ---
const keys = {};

window.addEventListener('keydown', (e) => {
  keys[e.code] = true;

  if (gameState === 'START') {
    startGame();
    return;
  }

  if (gameState === 'GAMEOVER' && (e.code === 'KeyR' || e.code === 'Space')) {
    nextDay();
    return;
  }

  if (gameState === 'PLAYING' && !player.attacking) {
    if (e.code === 'Space') {
      player.attacking = true;
      player.attackType = 'smash';
      player.attackTimer = 12;
      playSound('smash');
      checkAttackHit();
    } else if (e.code === 'Enter') {
      player.attacking = true;
      player.attackType = 'breath';
      player.attackTimer = 20;
      playSound('breath');
      checkAttackHit();
    }
  }
});

window.addEventListener('keyup', (e) => {
  keys[e.code] = false;
});

// Click to start on mobile/touch screens
canvas.addEventListener('click', () => {
  if (gameState === 'START') startGame();
  else if (gameState === 'GAMEOVER') nextDay();
});

// --- GAME LOGIC ---
function startGame() {
  score = 0;
  timer = 60;
  dayCounter = 1;
  gameState = 'PLAYING';
  initBuildings();
  resetTimer();
}

function nextDay() {
  dayCounter++;
  timer = 60;
  gameState = 'PLAYING';
  initBuildings();
  playSound('rebuild');
  resetTimer();
}

function resetTimer() {
  clearInterval(timerInterval);
  timerInterval = setInterval(() => {
    if (gameState === 'PLAYING') {
      timer--;
      if (timer <= 0) {
        gameState = 'GAMEOVER';
        if (score > highScore) highScore = score;
        clearInterval(timerInterval);
      }
    }
  }, 1000);
}

function createDebris(x, y) {
  for (let i = 0; i < 8; i++) {
    particles.push({
      x: x, y: y,
      vx: (Math.random() - 0.5) * 6,
      vy: (Math.random() - 0.5) * 6,
      size: Math.random() * 5 + 3,
      life: 15
    });
  }
}

function addPopup(text, x, y, color = '#ffff00') {
  popups.push({ text, x, y, life: 30, color });
}

function checkAttackHit() {
  const range = player.attackType === 'breath' ? 220 : 60;
  const attackX = player.dir === 'right' ? player.x + player.w : player.x - range;

  buildings.forEach(b => {
    if (b.hp > 0) {
      if (attackX < b.x + b.w && attackX + range > b.x) {
        const damage = player.attackType === 'breath' ? 35 : 20;
        b.hp = Math.max(0, b.hp - damage);
        
        const pts = player.attackType === 'breath' ? 200 : 100;
        score += pts;

        addPopup(`+${pts}`, b.x + b.w / 2, b.y + 20);
        createDebris(b.x + b.w / 2, b.y + b.h / 2);

        if (b.hp === 0) {
          score += 500;
          addPopup("DESTROYED! +500", b.x + b.w / 2, b.y - 10, '#ff0055');
        }
      }
    }
  });
}

function update() {
  if (gameState !== 'PLAYING') return;

  if (keys['KeyA'] || keys['ArrowLeft']) {
    player.x -= player.speed;
    player.dir = 'left';
  }
  if (keys['KeyD'] || keys['ArrowRight']) {
    player.x += player.speed;
    player.dir = 'right';
  }

  player.x = Math.max(0, Math.min(canvas.width - player.w, player.x));

  if (player.attacking) {
    player.attackTimer--;
    if (player.attackTimer <= 0) player.attacking = false;
  }

  // Update particle debris
  particles.forEach((p, i) => {
    p.x += p.vx;
    p.y += p.vy;
    p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  });

  // Update floating text popups
  popups.forEach((pop, i) => {
    pop.y -= 1;
    pop.life--;
    if (pop.life <= 0) popups.splice(i, 1);
  });
}

// --- RENDER GAME ---
function drawPlayer() {
  ctx.save();
  ctx.translate(player.x + player.w / 2, player.y + player.h / 2);
  if (player.dir === 'left') ctx.scale(-1, 1);

  // Body
  ctx.fillStyle = '#1c7c34';
  ctx.fillRect(-20, -35, 40, 70);

  // Head
  ctx.fillStyle = '#145a25';
  ctx.fillRect(-10, -45, 35, 22);

  // Eye
  ctx.fillStyle = '#ffea00';
  ctx.fillRect(15, -40, 6, 6);

  // Back Spikes
  ctx.fillStyle = '#00ffaa';
  ctx.fillRect(-26, -25, 6, 8);
  ctx.fillRect(-26, -10, 6, 8);
  ctx.fillRect(-26, 5, 6, 8);

  // Breath Attack (Atomic Beam)
  if (player.attacking && player.attackType === 'breath') {
    ctx.fillStyle = '#00ffff';
    ctx.fillRect(25, -40, 200, 12);
  }
  // Smash Attack (Claw Hit)
  if (player.attacking && player.attackType === 'smash') {
    ctx.fillStyle = '#ffea00';
    ctx.fillRect(20, -15, 30, 12);
  }

  ctx.restore();

  // Name Tag
  ctx.fillStyle = '#00ff66';
  ctx.font = '12px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('CHOTA BABY MROQ', player.x + player.w / 2, player.y - 12);
}

function draw() {
  // Screen Background
  ctx.fillStyle = '#0a0014';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Moon
  ctx.fillStyle = '#fff59d';
  ctx.beginPath();
  ctx.arc(720, 60, 30, 0, Math.PI * 2);
  ctx.fill();

  // Chembur Ground Line
  ctx.fillStyle = '#221100';
  ctx.fillRect(0, 360, canvas.width, 90);
  ctx.fillStyle = '#00ff66';
  ctx.fillRect(0, 356, canvas.width, 4);

  // Buildings
  buildings.forEach(b => {
    if (b.hp > 0) {
      const currentH = (b.h * (b.hp / b.maxHp));
      const currentY = 360 - currentH;

      ctx.fillStyle = '#3a3a5c';
      ctx.fillRect(b.x, currentY, b.w, currentH);

      // Building Windows
      ctx.fillStyle = '#ffea00';
      for (let wx = b.x + 10; wx < b.x + b.w - 10; wx += 20) {
        for (let wy = currentY + 10; wy < 350; wy += 25) {
          ctx.fillRect(wx, wy, 8, 12);
        }
      }

      ctx.fillStyle = '#ffffff';
      ctx.font = '10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(b.name, b.x + b.w / 2, 378);
    } else {
      ctx.fillStyle = '#333';
      ctx.fillRect(b.x, 345, b.w, 15);
      ctx.fillStyle = '#ff0055';
      ctx.font = '10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('RUINED', b.x + b.w / 2, 357);
    }
  });

  // Characters & Effects
  drawPlayer();

  particles.forEach(p => {
    ctx.fillStyle = '#ffaa00';
    ctx.fillRect(p.x, p.y, p.size, p.size);
  });

  popups.forEach(pop => {
    ctx.fillStyle = pop.color;
    ctx.font = 'bold 14px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(pop.text, pop.x, pop.y);
  });

  // HUD / Scoreboard
  ctx.fillStyle = '#00ff66';
  ctx.font = 'bold 16px monospace';
  ctx.textAlign = 'left';
  ctx.fillText(`SCORE: ${score}`, 20, 30);
  ctx.fillText(`DAY: ${dayCounter}`, 20, 52);

  ctx.textAlign = 'right';
  ctx.fillStyle = timer <= 10 ? '#ff0055' : '#00ff66';
  ctx.fillText(`TIME: ${timer}s`, canvas.width - 20, 30);
  ctx.fillStyle = '#00ff66';
  ctx.fillText(`HIGH SCORE: ${highScore}`, canvas.width - 20, 52);

  // Overlay Screens
  if (gameState === 'START') {
    ctx.fillStyle = 'rgba(0, 0, 0, 0.88)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#00ff66';
    ctx.font = 'bold 22px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('CHOTA BABY MROQ DESTROYS CHEMBUR', canvas.width / 2, 180);

    ctx.font = '15px monospace';
    ctx.fillStyle = '#ffffff';
    ctx.fillText('PRESS ANY KEY (OR CLICK) TO START', canvas.width / 2, 240);
  } else if (gameState === 'GAMEOVER') {
    ctx.fillStyle = 'rgba(0, 0, 0, 0.88)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#ff0055';
    ctx.font = 'bold 26px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('TIME IS UP!', canvas.width / 2, 150);

    ctx.fillStyle = '#ffffff';
    ctx.font = '18px monospace';
    ctx.fillText(`TOTAL SCORE: ${score}`, canvas.width / 2, 200);

    ctx.fillStyle = '#00ff66';
    ctx.font = '14px monospace';
    ctx.fillText('Chembur has rebuilt overnight!', canvas.width / 2, 250);
    ctx.fillText("Press 'SPACE' or 'R' to destroy it again!", canvas.width / 2, 280);
  }
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
</body>
</html>
